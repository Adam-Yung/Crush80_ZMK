From aad3d03f2c5e367741d61027e0dd5be3267e941d Mon Sep 17 00:00:00 2001
From: Ritwick Verma <verma1997@gmail.com>
Date: Thu, 15 Oct 2026 15:32:26 -0700
Subject: [PATCH] zmk: fix conflicting return type in
 zmk_usb_user_activity_while_suspended stub

Patch 0004 changed the function to return int; the stub used when
CONFIG_ZMK_USB_SUSPEND_REATTACH is off still returned void.
---
 app/src/usb.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/app/src/usb.c b/app/src/usb.c
index fc570f0..9bc2400 100644
--- a/app/src/usb.c
+++ b/app/src/usb.c
@@ -304,7 +304,7 @@ static void usb_reattach_work_cb(struct k_work *work) {
 }
 #else
 void zmk_usb_report_send_result(bool ok) { ARG_UNUSED(ok); }
-void zmk_usb_user_activity_while_suspended(void) {}
+int zmk_usb_user_activity_while_suspended(void) { return 0; }
 #endif // CONFIG_ZMK_USB_SUSPEND_REATTACH
 
 void usb_status_cb(enum usb_dc_status_code status, const uint8_t *params) {
-- 
2.56.0

