config AW20216S
	bool "AW20216S LED matrix driver"
	depends on SPI
	help
	  Driver for the AWINIC AW20216S 216-channel SPI LED matrix controller.
	  Used on the Wobkey Crush 80 for per-key RGB lighting.

if AW20216S

config AW20216S_INIT_PRIORITY
	int "Init priority"
	default 90

config AW20216S_LOG_LEVEL
	int "Log level"
	default 3

config AW20216S_CHANNEL_SCAN
	bool "AW20216S channel scan mode (bring-up only)"
	help
	  Replaces normal RGB with a sequential scanner that lights each
	  (chip, sw_row, cs_col) for 400ms and prints the address over serial.
	  Use during bring-up to build the led_sw/led_cs channel map tables.
	  Must be disabled for production builds.

endif # AW20216S
