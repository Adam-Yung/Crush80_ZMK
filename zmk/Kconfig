rsource "drivers/usb/Kconfig"
rsource "drivers/bluetooth/Kconfig"
rsource "drivers/sensor/Kconfig"
rsource "drivers/watchdog/Kconfig"

config BOOT_DIAG
	bool "Boot diagnostic (.noinit SRAM buffer for SWS debug)"
	default n
	help
	  Records boot stage codes to a .noinit SRAM buffer that can be read
	  via SWS/BDT even when USB is not working.

config BOOT_DIAG_GPIO
	bool "Boot diagnostic GPIO heartbeat (PD7)"
	default y
	depends on BOOT_DIAG
	help
	  Toggle PD7 at each boot stage for logic analyzer visibility.

config FLASH_MGMT
	bool "Raw flash management via mcumgr"
	default n
	depends on MCUMGR && FLASH
	help
	  Adds a custom mcumgr group (ID 64) with raw flash erase/write/read
	  commands. Used to restore original firmware via USB without SWS
	  hardware.

config CRUSH80_LAYER_RGB
	bool "Per-layer and per-modifier backlight colour (single colour, superseded by the per-key engine)"
	default y
	depends on !CRUSH80_RGB_ENGINE
	depends on CRUSH80_RGB && ZMK_RGB_UNDERGLOW && DT_HAS_CRUSH80_LAYER_RGB_ENABLED
	help
	  Follows the active layer and held modifiers with the backlight colour. Colours come
	  from the crush80,layer-rgb node in the keymap. Needs the Solid effect.

config CRUSH80_RGB_ENGINE
	bool "Per-key backlight engine"
	default y
	depends on CRUSH80_RGB && !ZMK_RGB_UNDERGLOW && DT_HAS_CRUSH80_RGB_SCHEME_ENABLED
	help
	  Colours each key by what it does on the active layer and lights the side bar and logo in
	  the layer colour. Replaces ZMK's single-colour underglow, which must be off.

config CRUSH80_RGB_BRT_MAX
	int "Backlight maximum brightness (percent of full)"
	default 25
	range 1 100
	depends on CRUSH80_RGB_ENGINE

config CRUSH80_RGB_BUDGET
	int "Frame current budget (sum of all colour channels, 0-117810)"
	default 30000
	depends on CRUSH80_RGB_ENGINE
	help
	  A frame whose channel sum is larger is scaled down. 30000 is about 25 percent of all LEDs
	  at full white, the cap the board has run with since the first RGB test.

config CRUSH80_OS
	bool "macOS / Windows layer selection with saved choice"
	default y

config CRUSH80_RGB
	bool "Crush 80 Reboot Pro LED strip"
	depends on DT_HAS_TELINK_B91_SPI_LED_STRIP_ENABLED && GPIO && LED_STRIP
	select DYNAMIC_INTERRUPTS
	help
	  Drives the 154 WS2812-compatible LEDs via PSPI and DMA on PB7.
	  Enable via conf/rgb.conf and conf/rgb.overlay.

config CRUSH80_MANUAL_CONFIRM
	bool "Leave new images unconfirmed until the host confirms them"
	default y
	depends on BOOTLOADER_MCUBOOT
	help
	  Trial boot. A freshly swapped-in image stays unconfirmed, so any
	  cold boot (unplug and replug) restores the previous image. The
	  host tool confirms after it has checked the board. Disable only
	  for builds that must self-confirm with no host present.
